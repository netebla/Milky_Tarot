BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# При необходимости на ВМ включите прокси для Telegram и OpenRouter (см. utils/proxy.py).
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
PROXY_ENABLED=false
# Формат: http://user:pass@host:port  (или socks5://... при поддержке прокси-сервером)
PROXY_URL=
# Без прокси: локальные сервисы и ЮKassa (российский API).
NO_PROXY=localhost,127.0.0.1,db,tarot_db,postgres,redis,api.yookassa.ru,yookassa.ru
TZ=Europe/Moscow
GITHUB_REPOSITORY_OWNER=your_github_username
PAYMENT_BOT_TOKEN=your_payment_bot_token_here
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here
YOOKASSA_RETURN_URL=https://t.me/YourBot
POSTGRES_USER=tarot
POSTGRES_PASSWORD=tarotpass
POSTGRES_DB=tarot_db
